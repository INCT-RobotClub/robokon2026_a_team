/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART2_UART_Init();
  MX_CAN1_Init();
  MX_CAN2_Init();
  /* USER CODE BEGIN 2 */
  HAL_CAN_Start(&hcan1);
  HAL_CAN_ActivateNotification(&hcan1, CAN_IT_RX_FIFO0_MSG_PENDING);
  HAL_CAN_Start(&hcan2);
  HAL_CAN_ActivateNotification(&hcan2, CAN_IT_RX_FIFO0_MSG_PENDING);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
	  if(HAL_GetTick() - pre_loop > 20){
		  CalculateSpeed(joystick[0],joystick[1]);
		  transmit_robomas(currentPower);

		  static char buff[256];
		  int size = snprintf(buff, sizeof(buff), "joyX:%4d joyY:%4d Speed:%4d %4d %4d %4d RecieveSpeed: %4d %4d %4d %4d \n\r" ,joystick[0],joystick[1],currentPower[0],currentPower[1],currentPower[2],currentPower[3],motors[0].rpm,motors[1].rpm, motors[2].rpm,motors[3].rpm);
		  HAL_UART_Transmit_IT(&huart2, (uint8_t*)buff, size);

		  pre_loop = HAL_GetTick();
	  }

	  if(canRxFlag){
		  canRxFlag = 0;
	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}


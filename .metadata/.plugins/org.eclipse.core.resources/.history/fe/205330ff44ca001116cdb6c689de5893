/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_USART1_UART_Init();
  MX_ADC2_Init();
  /* USER CODE BEGIN 2 */
  HAL_ADC_Start_DMA(&hadc2,(uint32_t*)ADCBuff,NUMBER_OF_VRS);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

	  readButton(button);
	  //MAP
	  for(int i = 0; i < NUMBER_OF_VRS; i++){
		  ADCValue[i] = ADCBuff[i];
	  }
	  uint16_t sum = 0;

	  txData[0] = 0x80;
	  txData[1] = (button[0]&1)|((button[1]&1)<<1)|((button[2]&1)<<2)|((button[3]&1)<<3)|((button[4]&1)<<4)|((button[5]&1)<<5)|((button[6]&1)<<6);
	  txData[2] = (button[7]&1)|((button[8]&1)<<1)|((button[9]&1)<<2)|((button[10]&1)<<3)|((button[11]&1)<<4);
	  txData[3] = ADCValue[1];//stickL(X)
	  txData[4] = ADCValue[0];//stickL(Y)
	  txData[5] = ADCValue[3];//stickR(X)
	  txData[6] = ADCValue[2];//stickR(Y) no used
	  for(int i = 0; i < 7; i++){
		  sum += txData[i];
	  }
	  txData[7] = (uint8_t)(sum & 0x7F);

	  if(HAL_GetTick() - preTick >= 50){
	  	 		  preTick = HAL_GetTick();

	  	 			char a[255];
	  	 			int size = snprintf(a,sizeof(a),"%2X %2X %2X %2X %2X %2X %2X %2X \n\r",txData[0],txData[1],txData[2],txData[3],txData[4],txData[5],txData[6],txData[7]);
	  	 			//int size = snprintf(a,sizeof(a),"%2d %2d %2d %2d %2d %2d %2d %2d %2d %2d %2d %2d \n\r",button[0],button[1],button[2],button[3],button[4],button[5],button[6],button[7],button[8],button[9],button[10],button[11]);
	  	 			//int size = snprintf(a,sizeof(a),"Buff :%2X %2X %2X %2X Value :%2X %2X %2X %2X \n\r",ADCBuff[0],ADCBuff[1],ADCBuff[2],ADCBuff[3],ADCValue[0],ADCValue[1],ADCValue[2],ADCValue[3]);
	  	 			//int size = snprintf(a,sizeof(a),"%2X %2X \n\r",ADCValue[2],txData[2]);
	  	 			HAL_UART_Transmit_IT(&huart2,(uint8_t*)a,size);

	  	 		  	HAL_UART_Transmit_IT(&huart1,txData,8);

	  	 	  }
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}


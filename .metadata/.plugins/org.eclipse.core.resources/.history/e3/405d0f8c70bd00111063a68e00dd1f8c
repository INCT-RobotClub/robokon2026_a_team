void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan) {
	CAN_RxHeaderTypeDef RxHeader;
	uint8_t RxData[8];
	if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK) {
		if (RxHeader.StdId == LS_ID) {
			for (int i = 0; i < 7 && i < NUM_LS; i++) {
				LS[i] = RxData[i];
			}
		}
	}
}

void can_transmit(uint32_t Id, uint8_t *pData, uint8_t length) {
	CAN_TxHeaderTypeDef TxHeader;
	uint32_t TxMailbox;
	uint8_t TxData[8] = { 0 };

	if (HAL_CAN_GetTxMailboxesFreeLevel(&hcan1) > 0) {
		TxHeader.StdId = Id;
		TxHeader.RTR = CAN_RTR_DATA;
		TxHeader.IDE = CAN_ID_STD;
		TxHeader.DLC = 8;
		TxHeader.TransmitGlobalTime = DISABLE;

		for (int i = 0; i < length && i < 8; i++) {
			TxData[i] = pData[i];
		}

		if (HAL_CAN_AddTxMessage(&hcan1, &TxHeader, TxData, &TxMailbox)== HAL_OK) {
			//HAL_GPIO_TogglePin(GPIOA, GPIO_PIN_5); /* Toggle LED on transmission */
		}
	}
}

void judge(void) {

	/* 1. Clear current outputs for motors and solenoids */
	for (int i = 0; i < NUM_MOTORS; i++) {
		motor_PWM[i] = MOTOR_STOP;
	}
	for (int i = 0; i < NUM_SOLENOIDS; i++) {
		solenoid[i] = SOLENOID_OFF;
	}
	servo[SM_CATCH_BUCKET] = SERVO_HV_STOP;


	/* 2. Process mechanism configurations */
	for (size_t i = 0; i < NUM_MECH_CONFIGS; i++) {
		MechanismConfig cfg = mech_configs[i];

		/* Check limit switch status */
		uint8_t ls_pressed = (cfg.ls_idx != LS_NONE) ? LS[cfg.ls_idx] : 0;

		if ((controler[cfg.ctrl_idx] & cfg.btn_mask) && (ls_pressed == 0)) {
			if (cfg.type == ACT_MOTOR) {
				motor_PWM[cfg.target_idx] = (uint8_t) cfg.speed;
				motor_DIR[cfg.target_idx] = cfg.direction;
			} else if (cfg.type == ACT_SOLENOID) {
				solenoid[cfg.target_idx] = (uint8_t) cfg.speed;
			} else if (cfg.type == ACT_SERVO) {
				servo[cfg.target_idx] = cfg.speed;
			} else if (cfg.type == ACT_MACRO) {
				if (state == 0) {
					state = 1;
					if (cfg.target_idx == S_FLAG) {
						supplyButton = 1;
					} else if (cfg.target_idx == S_DESK) {
						supplyButton = 2;
					}
				}
			}
		}
	}
}

void transmit_data(){

	/* 3. Check and transmit motor speed/direction updates */

	for (int i = 0; i < NUM_MOTORS; i++) {
		if (motor_PWM[i] != prev_motor_PWM[i] || motor_DIR[i] != prev_motor_DIR[i]) {
			motor_changed = 1;
			prev_motor_PWM[i] = motor_PWM[i];
		}
	}
	if (motor_changed) {
		uint8_t sendData[8] = { 0 };
		for (int i = 0; i < NUM_MOTORS && i < 4; i++) {
			sendData[i] = motor_PWM[i];
			sendData[i + 4] = motor_DIR[i];
		}
		can_transmit(MOTOR_ID, sendData, 8);
		motor_changed = 0;
	}

	/* 4. Check and transmit solenoid updates */

	for (int i = 0; i < NUM_SOLENOIDS; i++) {
		if (solenoid[i] != prev_solenoid[i]) {
			solenoid_changed = 1;
			prev_solenoid[i] = solenoid[i];
		}
	}
	if (solenoid_changed) {
		uint8_t sendData[8] = { 0 };
		for (int i = 0; i < NUM_SOLENOIDS && i < 8; i++) {
			sendData[i] = solenoid[i];
		}
		can_transmit(SOLENOID_ID, sendData, 8);
		solenoid_changed = 0;
	}

	/* 5. Check and transmit servo updates */
	for (int i = 0; i < NUM_SM; i++) {
		if (servo[i] != prev_servo[i]) {
			servo_changed = 1;
			prev_servo[i] = servo[i];
		}
	}
	if (servo_changed) {
		uint8_t send[8] = {0};
		send[0] = (uint8_t) (servo[SM_CATCH] >> 8);
		send[1] = (uint8_t) (servo[SM_CATCH] & 0xFF);
		send[2] = (uint8_t) (servo[SM_CATCH_BUCKET] >> 8);
		send[3] = (uint8_t) (servo[SM_CATCH_BUCKET] & 0xFF);
		can_transmit(SM_CATCH_ID, send, 8);
		servo_changed = 0;
	}

	/* 6. ROBOMAS*/
	uint8_t send[8] = {0};
	send[0] = controler[CTRL_STICKX];
	send[1] = controler[CTRL_STICKY];
	send[2] = controler[CTRL_STICK2X];
	can_transmit(ROBOMAS_ID, send, 8);

}

void Macro(uint8_t supplyData) {
	switch (state) {
	case 1:
		//servo close
		if(LS[LS_SUPPLY_MIN] == 1){
			if(servo[SM_CATCH] == SERVO_80){
				servo_close_time = HAL_GetTick();
			}
			servo[SM_CATCH] = SERVO_0;
			if(HAL_GetTick() - servo_close_time > 2000){
				supplyDownTime = HAL_GetTick();
				state = 2;
			}
		}
		break;
	case 2:
			motor_PWM[M_SUPPLY_CLOTH] = MOTOR_HARF;
			motor_DIR[M_SUPPLY_CLOTH] = 0;
		if (LS[LS_SUPPLY_BOTTOM] == 1) {
			motor_PWM[M_SUPPLY_CLOTH] = MOTOR_STOP;
			if(supplyData == 1){
				state = 3;
			}else {
				state = 4;
			}
		}
		break;
	case 3:
		//supply_LR
		motor_PWM[M_SUPPLY_LR] = MOTOR_HIGH;
		motor_DIR[M_SUPPLY_LR] = 1;
		if (LS[LS_SUPPLY_MID] == 1) {
			motor_PWM[M_SUPPLY_LR] = MOTOR_STOP;
			state = 5;
			servo_open_time = HAL_GetTick();
		}
		break;
	case 4:
		motor_PWM[M_SUPPLY_LR] = MOTOR_HIGH;
		motor_DIR[M_SUPPLY_LR] = 1;
		if (LS[LS_SUPPLY_MAX] == 1) {
			motor_PWM[M_SUPPLY_LR] = MOTOR_STOP;
			state = 5;
			servo_open_time = HAL_GetTick();
		}
		break;
	case 5:
		//servo open
		servo[SM_CATCH] = SERVO_80;
		if(HAL_GetTick() - servo_open_time >= 1000){
			state = 6;
		}
		break;
	case 6:
		//supply_LR
		/*
		motor_PWM[M_SUPPLY_LR] = MOTOR_HARF;
		motor_DIR[M_SUPPLY_LR] = 0;
		motor_changed = 1;
		state = 6;*/
		motor_PWM[M_SUPPLY_LR] = MOTOR_HIGH;
		motor_DIR[M_SUPPLY_LR] = 0;
		if (LS[LS_SUPPLY_MIN] == 1) {
			motor_PWM[M_SUPPLY_LR] = MOTOR_STOP;
			state = 0;
			supplyButton = 0;
		}
		break;
	}
}


void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
	if (huart->Instance == USART3) {

		if (count == 0) {
			if (UART_rx[count] == 0x80) {
				count = 1;
			}
		} else if (count > 0) {
			count++;
			if (count >= 7) { //Header(1) + Data(6) = 7 bytes total
				for (int i = 0; i < 6; i++) {
					controler[i] = UART_rx[i + 1];
				}
				UART_flag = 1;

				count = 0;
			}
		} else {
			count = 0;
		}
		//Setup reception for next byte
		HAL_UART_Receive_IT(&huart3, &UART_rx[count], 1);
	}
}


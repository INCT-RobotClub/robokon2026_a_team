void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan) {
	CAN_RxHeaderTypeDef RxHeader;
	uint8_t RxData[8];

	if (HAL_CAN_GetRxMessage(hcan, CAN_RX_FIFO0, &RxHeader, RxData) == HAL_OK) {
		rxId = (RxHeader.IDE == CAN_ID_STD) ? RxHeader.StdId : RxHeader.ExtId;
		rxDlc = RxHeader.DLC;
		for (int i = 0; i < 8; i++) {
			rxData[i] = RxData[i];

		}
		canRxFlag = 1;
	}
}

void Debug() {
	static char buff[64];
	int size = snprintf(buff, sizeof(buff), " %2d %2d %2d \n\r", PinState[0],
			PinState[1], PinState[2]);
	//int size = snprintf(buff, sizeof(buff), "%2d %2d %2d \n\r",rxData[0], rxData[1], rxData[2]);
	HAL_UART_Transmit_IT(&huart2, (uint8_t*) buff, size);
}
